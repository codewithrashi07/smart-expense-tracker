# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smarttrack?retryWrites=true&w=majority

# JWT Authentication
